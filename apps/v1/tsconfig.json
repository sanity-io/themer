{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    // Resolves the app's own modules from its root, like `utils/presets`
    // (what `"baseUrl": "."` used to do, which TypeScript 7 removed)
    "paths": {
      "*": ["./*"],
      // `edge-utils` is generated by `build:edge` (run by `prebuild` and
      // `predev`); until then, the declarations in `typings` stand in for it
      "edge-utils/*": ["./edge-utils/*", "./typings/edge-utils/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "typings"],
  "exclude": ["node_modules", "examples"]
}
