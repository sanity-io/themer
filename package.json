{
  "name": "sanity-themer-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "scripts": {
    "build": "pnpm --filter @sanity/themer-legacy build",
    "changeset": "changeset",
    "clean": "pnpm --recursive clean",
    "dev": "pnpm --filter sanity-themer-storybook dev",
    "dev:v1": "pnpm --filter v1 dev",
    "format": "prettier --cache --write .",
    "lint": "pnpm run oxlint",
    "lint:fix": "pnpm lint --fix --fix-suggestions",
    "oxlint": "oxlint --disable-nested-config",
    "release": "changeset publish",
    "storybook:build": "pnpm --filter sanity-themer-storybook build",
    "test": "pnpm --filter @sanity/themer-legacy --filter v1 test",
    "test:browser": "pnpm --filter sanity-themer-storybook test",
    "watch": "pnpm --filter @sanity/themer-legacy watch"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "eslint-plugin-storybook": "^10.6.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "3.2.5",
    "prettier-plugin-packagejson": "2.4.14",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13"
  }
}
