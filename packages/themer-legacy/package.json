{
  "name": "@sanity/themer-legacy",
  "version": "0.2.2",
  "description": "The hosted Themer service (themer.sanity.build) as an npm package: the exact same Sanity Studio theme generator, running locally.",
  "keywords": [
    "sanity",
    "studio",
    "theme",
    "themer",
    "ui"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/themer/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/themer.git",
    "directory": "packages/themer-legacy"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@sanity/color": "catalog:",
    "@sanity/tsdown-config": "catalog:",
    "@sanity/ui": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sanity/ui": "^2 || ^3 || ^4"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
